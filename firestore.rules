rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Studio content: public read so every visitor sees the latest updates; write allowed so admin can update from Netlify/mobile/desktop
    match /studio/content {
      allow read: if true;
      allow write: if true;
    }

    // Client leads and project briefs: public create on submission; read/update/delete for admin management
    match /leads/{leadId} {
      allow read, write: if true;
    }
  }
}
